<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Notifications (runtime-prompted on Android 13+; declared explicitly
         rather than relying on the notification plugin's manifest merge). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Background sync foreground service (Settings → Notifications). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Push wake-ups (PushSyncService). Separate from the special-use grant
         above: this one is short-lived and typed, so it carries none of the
         long-running exemption's obligations. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SHORT_SERVICE" />
    <!-- Lets the app ask the user to exempt it from battery optimization so
         Doze doesn't strangle the persistent sync connection. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- allowBackup is disabled because the Android secrets fallback (secrets.rs)
         stores the store-encryption key and Matrix session as plaintext files in
         the app-private data dir; Auto Backup / device-transfer would copy those
         off-device. Disabling backup keeps them confined to the OS sandbox. -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.quark"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:allowBackup="false">
        <!-- Keyboard dodge (#33) is done by MainActivity.applyImeInsets — in
             edge-to-edge mode adjustResize alone never resizes the window.
             It stays declared so the system picks resize (not pan) semantics
             for IME inset dispatch instead of OEM adjustPan defaults. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps the Rust sync loop alive while backgrounded, for devices with
             no UnifiedPush distributor installed. Off by default now that push
             exists; it is the fallback, not the mechanism. specialUse because
             dataSync is runtime-capped on Android 15 and nothing else fits a
             persistent Matrix connection. -->
        <service
            android:name=".SyncForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent Matrix sync connection, used only when the user has no UnifiedPush distributor installed to deliver push notifications" />
        </service>

        <!-- Receives everything the UnifiedPush distributor sends: messages,
             endpoints, revocations. The connector library binds it, so it must
             not be exported and must answer PUSH_EVENT. The <queries> block
             that makes distributors visible under Android 11+ package
             visibility comes from the library's own manifest. -->
        <service
            android:name=".PushEventService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <!-- Runs a single push to completion. shortService rather than
             specialUse: it lives for one sync and Android may stop it after
             ~3 minutes, which is exactly the contract we want. Not exported —
             the only thing that starts it is PushEventService, inside this app
             (plus PushDebugReceiver in debug builds). -->
        <service
            android:name=".PushSyncService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
